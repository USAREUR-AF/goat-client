#!/bin/sh
# Stops a running daemon before the new payload lands. No-op on fresh install.
set -e

LAUNCHD_PLIST=/Library/LaunchDaemons/io.dlf-dds.goat-clientd.plist  # oss-allow: existing app identifier
LABEL=io.dlf-dds.goat-clientd  # oss-allow: existing app identifier

if launchctl print system/$LABEL >/dev/null 2>&1; then
    launchctl bootout system "$LAUNCHD_PLIST" || true
fi

# Quit GUI if running so the file replace can happen.
osascript -e 'tell application "goat-client" to quit' 2>/dev/null || true

exit 0
